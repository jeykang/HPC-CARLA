# Copy to .env and edit as needed

# Host GPU allocated to you
GPU_DEVICE_ID=3
NVIDIA_VISIBLE_DEVICES=3

# How many virtual "GPU slots" to emulate on that one GPU
VIRTUAL_GPUS=4

# Ports for CARLA servers
BASE_RPC_PORT=2000
PORT_SPACING=100
TM_OFFSET=5000

# Optional: build smaller image (may break some agents)
INSTALL_HEAVY_DEPS=0

# Worker behavior
AUTO_RESET=0
EXIT_ON_IDLE=0
IDLE_SLEEP_S=10

# Server launch backend (native in Docker)
CARLA_LAUNCH_BACKEND=native
